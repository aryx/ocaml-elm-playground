; claude: unit tests for the graphics/ libraries, run by 'make test'
; (dune runtest). Many of them check the worked examples given in the
; .mli comments, so those examples can't silently become wrong.
(test
 (name Test)
 (package elm_playground_software)
 (libraries
   alcotest
   testo
   cairo2 ; only to compare our pixels with Cairo's, see Unit_fill.ml
   graphics_core
   graphics_2d_geometry
   graphics_2d
   graphics_font
   graphics_3d_geometry
   graphics_3d
   graphics_images
   graphics_rgba
   graphics_deflate
   graphics_png
   graphics_gif
   graphics_jpeg
   graphics_yuv ; Psnr, for the JPEG writer's loss
   graphics_xpm
   graphics_gpu
 )
 (deps
   %{project_root}/examples/checker.png
   %{project_root}/games/adventure/tomb.png
   %{project_root}/games/fps/minecraft.png
   (source_tree pngsuite) ; Willem van Schaik's PngSuite, a subset
   (source_tree gifs) ; GIFs of our own
   (source_tree jpegs) ; JPEGs of our own, and libjpeg's pixels
 )
)

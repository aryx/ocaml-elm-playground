; claude: the image codecs compiled to JavaScript and run under node:
; an int has 32 bits there, 63 natively, and the codecs must not care
; (Crc32.mli). The same fixtures as ../'s tests, and the same expected
; values, as a plain program (Testo needs Unix): Test_js.ml. Run by
; 'make test' where node is installed, skipped elsewhere.
(executable
 (name Test_js)
 (modes js)
 (libraries graphics_rgba graphics_deflate graphics_png graphics_gif graphics_jpeg)
)

(rule
 (alias runtest)
 (enabled_if %{bin-available:node})
 (deps
   Test_js.bc.js
   (source_tree ../pngsuite)
   (source_tree ../gifs)
   (source_tree ../jpegs))
 (action (run node %{dep:Test_js.bc.js})))

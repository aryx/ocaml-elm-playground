   graphics_font
   graphics_3d_geometry
   graphics_3d
   graphics_raytrace ; Raytrace, Solid (Unit_raytrace)
   graphics_images
   graphics_rgba
   compression
   graphics_png
   graphics_gif
   graphics_jpeg
   graphics_yuv ; Psnr, for the JPEG writer's loss
   graphics_xpm
   graphics_gpu
   graphics_imaging ; Lut, Mask, Brush... (Unit_imaging)
   graphics_ilbm ; the Amiga's pictures (Unit_ilbm)
 )
 (deps
   %{project_root}/examples/checker.png
   %{project_root}/games/adventure/tomb.png
   %{project_root}/games/fps/minecraft.png
   (source_tree pngsuite) ; Willem van Schaik's PngSuite, a subset

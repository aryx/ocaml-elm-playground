; claude: the terminal the program runs in, native only: Tty_unix, a
; Tui program (../Tui.mli) run in a real terminal -- raw mode, the
; alternate screen, keys read as they come, curses' bytes written.
; In the package tiny_libs, as tiny_libs.terminal_unix.
(library
 (name terminal_unix)
 (public_name tiny_libs.terminal_unix)
 (wrapped false)
 (libraries
   unix
   caps ; Cap.stdin and Cap.stdout, which running in the terminal takes
   terminal ; Tui, Curses, Line_discipline
 )
)

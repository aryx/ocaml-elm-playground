; claude: reuse ../*.ml as-is (a build-time copy, not a committed
; symlink/duplicate) so the same backend-agnostic source runs against
; elm_playground_web here and elm_playground_native in ../dune, with
; only one real file per example.
(copy_files ../Smiley.ml)
(copy_files ../Picture.ml)
(copy_files ../Words.ml)
(copy_files ../Misc.ml)
(copy_files ../Animation.ml)
(copy_files ../Mouse.ml)
(copy_files ../Keyboard.ml)
(copy_files ../Turtle.ml)
(copy_files ../Mario.ml)
(copy_files ../Flags.{ml,mli})
(copy_files ../Orbit.{ml,mli})
(copy_files ../Bounce.{ml,mli})
(copy_files ../Marbles.{ml,mli})
(copy_files ../Boxes.{ml,mli})
(copy_files ../Pyramid.{ml,mli})
(copy_files ../Elastic.{ml,mli})
(copy_files ../SolarSystem.{ml,mli})
(copy_files ../Theremin.{ml,mli})
(copy_files ../Piano.{ml,mli})
(copy_files ../Fractals.{ml,mli})
(copy_files ../BigBangRocket.ml)
(copy_files ../BigBangWorm.ml)

(executables
  (names
    Smiley Picture Words Misc
    Animation
    Mouse Keyboard
    Turtle Mario
    Flags
    Orbit Bounce Marbles Boxes Pyramid Elastic SolarSystem Theremin Piano
    Fractals
    BigBangRocket
    BigBangWorm
  )
  (libraries
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/<dir>/ next to the
; generated .bc.js so the directory can be opened directly in a browser.
; Defining the 'default' alias overrides dune's implicit one, hence the
; explicit (alias all) to still build the executables.
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

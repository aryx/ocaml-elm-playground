(executables
  (names
    Smiley Picture Words Misc
    Animation
    Mouse Keyboard
    Turtle Mario
    Flags
    PhysicsOrbit PhysicsBounce PhysicsMarbles PhysicsBoxes PhysicsPyramid PhysicsElastic PhysicsSolarSystem
    AudioTheremin AudioPiano AudioAliasing AudioSfx AudioSpace AudioSampler
    AiTictactoe AiPathfinding AiSteering AiFlock AiGhosts AiBots AiDebug
    LogoFractals
    BigBangRocket
    BigBangWorm
    PuzzleScriptSokoban
    PuzzleScriptBoulders
  )
  (modules :standard \ Triangle3d Cube3d Cubes3d Spheres3d TexturedCube3d
    InteractiveCube3d PaintersAlgorithmFail3d FloatingCity3d Corridor3d
    CachedGrid3d PhysicsSolarSystem3d PhysicsSpin3d PhysicsFloat3d
    PhysicsHitbox3d PhysicsBounce3d PhysicsMarbles3d PhysicsRoll3d
    PhysicsStack3d PhysicsWalk3d PhysicsRagdoll3d LogoFractals3d StarCollector3d)
  (libraries
    elm_playground
    ai ; AiTictactoe's Minimax
    kit_maze ; AiGhosts' Grid_move and Chase
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: and the 3D examples, on WebGL (../svg/ has them drawn as SVG)
(executables
  (names
    Triangle3d
    Cube3d
    Cubes3d
    Spheres3d
    TexturedCube3d
    InteractiveCube3d
    PaintersAlgorithmFail3d
    FloatingCity3d
    Corridor3d
    CachedGrid3d
    PhysicsSolarSystem3d
    PhysicsSpin3d
    PhysicsFloat3d
    PhysicsHitbox3d
    PhysicsBounce3d
    PhysicsMarbles3d
    PhysicsRoll3d
    PhysicsStack3d
    PhysicsWalk3d
    PhysicsRagdoll3d
    LogoFractals3d
    StarCollector3d
  )
  (modules Triangle3d Cube3d Cubes3d Spheres3d TexturedCube3d
    InteractiveCube3d PaintersAlgorithmFail3d FloatingCity3d Corridor3d
    CachedGrid3d PhysicsSolarSystem3d PhysicsSpin3d PhysicsFloat3d
    PhysicsHitbox3d PhysicsBounce3d PhysicsMarbles3d PhysicsRoll3d
    PhysicsStack3d PhysicsWalk3d PhysicsRagdoll3d LogoFractals3d StarCollector3d)
  (libraries
    elm_core ; Set_.mem, Basics.clamp
    elm_playground
    elm_playground_web ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_webgl ; implem of virtual elm_playground_3d
    physics_2d ; PhysicsSolarSystem3d's Kepler and Planets
    physics_3d ; PhysicsSpin3d's Quat, Body3d, Integrate3d; PhysicsFloat3d's Force3d; PhysicsHitbox3d's Hitbox3d; PhysicsBounce3d's Resolve3d; PhysicsMarbles3d's Broadphase3d; PhysicsRoll3d's rolling; PhysicsStack3d's Solver3d
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/<dir>/ next to the
; generated .bc.js so the directory can be opened directly in a browser.
; Defining the 'default' alias overrides dune's implicit one, hence the
; explicit (alias all) to still build the executables.
; claude: and the textures, where the WebGL pages look for them (see
; examples/dune in this directory)
(rule
  (alias default)
  (deps (glob_files *.html) (alias all) examples/checker.png)
  (action (progn)))

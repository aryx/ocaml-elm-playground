; claude: reuse ../*.ml as-is (a build-time copy, not a committed
; symlink/duplicate) so the same backend-agnostic source runs against
; elm_playground_web here and elm_playground_native in ../dune, with
; only one real file per game.
(copy_files ../Snake.ml)
(copy_files ../Pong.ml)
(copy_files ../Tetris.ml)
(copy_files ../Asteroid.ml)
(copy_files ../TinyMario.{ml,mli})
(copy_files ../TinyInvaders.{ml,mli})
(copy_files ../TinySokoban.{ml,mli})
(copy_files ../TinyPacman.{ml,mli})
(copy_files ../TinyWolf.{ml,mli})
(copy_files ../TinyOutRun.{ml,mli})
(copy_files ../TinyBomberman.{ml,mli})
(copy_files ../TinyTron.{ml,mli})
(copy_files ../TinyWorms.{ml,mli})
(copy_files ../TinySpacewar.{ml,mli})
(copy_files ../TinyPong.{ml,mli})
(copy_files ../TinyCameltry.{ml,mli})

(executables
  (names
    Snake
    Pong
    Tetris
    Asteroid
    TinyMario
    TinyInvaders
    TinySokoban
    TinyPacman
    TinyWolf
    TinyOutRun
    TinyBomberman
    TinyTron
    TinyWorms
    TinySpacewar
    TinyPong
    TinyCameltry
  )
  (libraries
    unix
    elm_playground
    kit_racing ; TinyOutRun's Road and Car
    kit_maze ; TinyPacman's and TinyBomberman's Grid_move and Chase
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/<dir>/ next to the
; generated .bc.js so the directory can be opened directly in a browser.
; Defining the 'default' alias overrides dune's implicit one, hence the
; explicit (alias all) to still build the executables.
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

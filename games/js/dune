  (libraries
    ai ; AiOthello's Minimax, TinyTowerDefense's and the RTS games' Pathfind
    kit_rts ; TinyDune2's, TinyWarcraft2's and TinyGauntlet2's orders and paths
    unix
    elm_playground
    kit_racing ; TinyMicroMachines' Topdown
    kit_maze ; TinyPacman's and TinyBomberman's Grid_move and Chase
    kit_lightcycles ; TinyTron's rules
    kit_shmup ; TinyInvaders', TinyGalaga's and TinyRobotron's Shots and Path
    kit_platformer ; TinyMario's, TinyLodeRunner's and TinyRick's Tile_move and Ladder
    kit_brawler ; TinyFinalFight's and TinyStreetFighter's Hitbox, Frame_data and Stickman
    kit_puzzle ; TinySokoban's and TinyBabaIsYou's Push and Undo
    kit_sports ; the free ball and formation of TinyKickOff2, TinySpeedball2 and TinySensibleSoccer
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/<dir>/ next to the
; generated .bc.js so the directory can be opened directly in a browser.
; Defining the 'default' alias overrides dune's implicit one, hence the
; explicit (alias all) to still build the executables.
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

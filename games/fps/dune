; claude: the first-person games (CATALOG.md's section): the 2.5D ones
; (their 3D look drawn by the game itself on the 2D playground, see
; ../README-2.5d.md) next to their 3D twins; on the software
; rasterizers in software/, in the browser in web/.
(executables
  (names TinyBattlezone TinyDoom TinyMazeWar TinyWolfenstein)
  (modules TinyBattlezone TinyDoom TinyMazeWar TinyWolfenstein)
  (libraries
    elm_playground
    kit_sectors ; TinyDoom's level
    elm_playground_native ; implem of virtual elm_playground
  )
)

(executables
  (names TinyBattlezone3d TinyCyberSled TinyDoom3d TinyHalfLife2 TinyMinecraft
    TinyQuake TinyTeardown TinyWolfenstein3d)
  (modules TinyBattlezone3d TinyCyberSled TinyDoom3d TinyHalfLife2 TinyMinecraft
    TinyQuake TinyTeardown TinyWolfenstein3d Texture_atlas)
  (libraries
    elm_core
    kit_sectors ; TinyDoom3d's level, TinyDoom's own
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

; claude: minecraft.png, embedded in TinyMinecraft as base64 (see
; Playground3d.embedded_texture and core/'s Base64.mli), so it
; runs from any directory and its texture comes along to the browser --
; the same trick graphics/font/dune uses for the Hershey font, through a
; script since a .png is not text.
(rule
 (targets Texture_atlas.ml)
 (deps minecraft.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml minecraft.png))))

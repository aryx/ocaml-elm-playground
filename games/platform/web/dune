(copy_files ../*.ml)

(executables
  (names TinyBraid TinyCeleste TinyDonkeyKong TinyJoust TinyLodeRunner TinyMario
    TinyMarioWorld TinyMetroid TinyPrinceOfPersia TinyRick TinySonic)
  (modules TinyBraid TinyCeleste TinyDonkeyKong TinyJoust TinyLodeRunner TinyMario
    TinyMarioWorld TinyMetroid TinyPrinceOfPersia TinyRick TinySonic
    Mario_xpm Celeste_xpm)
  (libraries
    elm_playground
    kit_platformer
    kit_puzzle
    kit_shmup
    kit_brawler
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

(executables
  (names TinyMario64)
  (modules TinyMario64)
  (libraries
    elm_core
    elm_playground
    elm_playground_web ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_webgl ; implem of virtual elm_playground_3d
  )
  (modes js)
  (link_flags -no-check-prims)
)

; the .html pages next to the .bc.js
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

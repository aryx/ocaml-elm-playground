; claude: the puzzle and board games (CATALOG.md's section), 2D and 3D
; side by side; on the software rasterizers in software/, in the
; browser in web/.
(executables
  (names AiChess AiConnect4 AiGo AiOthello AiShannon Tetris TinyBabaIsYou TinyCrush TinyFez TinyIncredibleMachine
    TinyLemmings TinyPortal2D TinyPuzzleBobble TinySlingshot TinySokoban
    TinySokobanEd TinyStoneAge TinyTetris TinyWitness)
  (modules AiChess AiConnect4 AiGo AiOthello AiShannon Tetris TinyBabaIsYou TinyCrush TinyFez TinyIncredibleMachine
    TinyLemmings TinyPortal2D TinyPuzzleBobble TinySlingshot TinySokoban
    TinySokobanEd TinyStoneAge TinyTetris TinyWitness Sokoban_levels Fez_xpm)
  (libraries
    unix ; Tetris's clock
    caps ; TinySokobanEd's authority to export its file
    elm_playground
    ai ; AiChess's and AiOthello's Minimax, AiShannon's Bigram and Ngram_mlp
    data_names ; AiShannon's hidden names, makemore's
    data_weights_names_mlp ; and its network, trained by scripts/train/train_names
    data_weights_names_gpt ; and its GPT, by train_names_gpt
    data_weights_connect4 ; AiConnect4's network, by train_connect4
    data_weights_go9 ; AiGo's network, by train_go
    random ; AiGo's playouts, Lehmer (Mcts's)
    kit_puzzle ; TinySokoban's and TinyBabaIsYou's Push and Undo, Sokoban's rules
    kit_boards ; AiConnect4's rules, Connect4, shared with its trainer
    kit_crush ; TinyCrush's levels and rules, Crush
    kit_platformer ; TinyFez's running and jumping, Tile_move
    elm_playground_native ; implem of virtual elm_playground
  )
)

; claude: TinySokoban's levels, in Sokoban's own text format, embedded
; as a string: TinySokoban.xsb becomes Sokoban_levels.xsb (a value) at
; build time, so the game and its editor carry the levels with them. The
; file is what TinySokobanEd exports, byte for byte (see
; games/README-tools.md)
(rule
 (targets Sokoban_levels.ml)
 (deps TinySokoban.xsb)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from TinySokoban.xsb by games/puzzle/dune *)\n")
    (echo "let xsb = {|")
    (cat %{deps})
    (echo "|}\n")))))

; claude: TinyFez's pixel art -- the brick and grass faces, Gomez's two
; poses, the cube bit -- drawn as XPM files, embedded as strings:
; fez_brick.xpm becomes Fez_xpm.brick at build time, and so on, as
; TinyMario's are (see README-tools.md)
(rule
 (targets Fez_xpm.ml)
 (deps fez_brick.xpm fez_grass.xpm fez_gomez_stand.xpm fez_gomez_walk.xpm fez_bit.xpm)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from fez_*.xpm by games/puzzle/dune *)\n")
    (echo "let brick = {|")
    (cat fez_brick.xpm)
    (echo "|}\nlet grass = {|")
    (cat fez_grass.xpm)
    (echo "|}\nlet gomez_stand = {|")
    (cat fez_gomez_stand.xpm)
    (echo "|}\nlet gomez_walk = {|")
    (cat fez_gomez_walk.xpm)
    (echo "|}\nlet bit = {|")
    (cat fez_bit.xpm)
    (echo "|}\n")))))

(executables
  (names TinyBlockout TinyCrush3d TinyMonumentValley TinyPerspective TinyPortal)
  (modules TinyBlockout TinyCrush3d TinyMonumentValley TinyPerspective TinyPortal)
  (libraries
    elm_core
    physics_3d graphics_3d_geometry ; TinyPortal's bodies
    kit_crush ; TinyCrush3d's levels and rules, the same as TinyCrush's
    kit_platformer ; TinyPerspective's runner, Tile_move
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

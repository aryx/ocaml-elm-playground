; claude: the same games as ../dune, in the browser: the 2D ones on
; elm_playground_web, the 3D ones on WebGL
(copy_files ../*.ml)

(executables
  (names TinyDiablo TinyDungeonMaster TinyGauntlet2 TinyRogue)
  (modules TinyDiablo TinyDungeonMaster TinyGauntlet2 TinyRogue)
  (libraries
    elm_playground
    ai
    kit_rts
    kit_isometric
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

(executables
  (names TinyHades)
  (modules TinyHades)
  (libraries
    elm_core
    elm_playground
    elm_playground_web ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_webgl ; implem of virtual elm_playground_3d
  )
  (modes js)
  (link_flags -no-check-prims)
)

; the .html pages next to the .bc.js
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

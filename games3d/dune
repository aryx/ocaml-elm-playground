(executables
  (names
    StarCollector3d
    TinyBattlezone
    TinyWolf3d
    TinyVirtuaRacing
    TinyTron3d
    TinyMario64
    TinyMarble
    TinyDoom3d
    TinyComanche3d
    TinyDescent3d
    TinyQuake
  )
  (modules StarCollector3d TinyBattlezone TinyWolf3d TinyVirtuaRacing TinyTron3d TinyMario64 TinyMarble TinyDoom3d TinyComanche3d TinyDescent3d TinyQuake)
  (libraries
    kit_lightcycles ; TinyTron3d's rules
    kit_racing ; TinyVirtuaRacing's Road and Car
    kit_sectors ; TinyDoom3d's level
    kit_heightmap ; TinyComanche3d's island
    kit_segments ; TinyDescent3d's mine
    elm_core ; Basics.clamp
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_software ; implem of virtual elm_playground_3d
  )
)

; claude: its own stanza: TinyMinecraft uses none of the kits, and
; reads texture.png beside it.
(executables
  (names
    TinyMinecraft
  )
  (modules TinyMinecraft Texture_atlas)
  (libraries
    elm_core
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_software ; implem of virtual elm_playground_3d
  )
)

; claude: texture.png, embedded in the program as base64 (see
; Playground3d.embedded_texture and graphics/images/Base64.mli), so
; TinyMinecraft runs from any directory and its texture comes along to
; the browser -- the same trick graphics/font/dune uses for the Hershey
; font, through a script since a .png is not text.
(rule
 (targets Texture_atlas.ml)
 (deps texture.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml texture.png))))

    TinyPinball3d
    TinyWolfenstein3d
    TinyVirtuaRacing
    TinyMarioKart64
    TinyVirtuaFighter
    TinyStarFox
    TinyAloneInTheDark
    TinyTron3d
    TinyMario64
    TinyMarbleMadness
    TinyDoom3d
    TinyComanche3d
    TinyDescent3d
    TinyQuake
    TinyBlockout
    TinyTombRaider
    TinyBoomerangFu3d
    TinyHades
    TinyMonumentValley
    TinyRockBand
  )
  (modules StarCollector3d TinyBattlezone3d TinyElite3d TinyTeardown TinyPinball3d TinyWolfenstein3d TinyVirtuaRacing TinyMarioKart64 TinyVirtuaFighter TinyStarFox TinyAloneInTheDark TinyTron3d TinyMario64 TinyMarbleMadness TinyDoom3d TinyComanche3d TinyDescent3d TinyQuake TinyBlockout TinyTombRaider TinyBoomerangFu3d TinyHades TinyMonumentValley TinyRockBand Tomb_atlas)
  (libraries
    kit_puzzle ; TinyTombRaider's Push, the same one TinySokoban uses
    kit_lightcycles ; TinyTron3d's rules
    kit_rhythm ; TinyRockBand's clock, grades and charts, shared with games/TinyDDR
    kit_racing ; TinyVirtuaRacing's Road and Car, TinyMarioKart64's Topdown
    kit_racing3d ; TinyMarioKart64's circuit (Track3d)
    kit_brawler ; TinyVirtuaFighter's Frame_data and Hitbox, shared with the 2D fighters
    kit_brawler3d ; TinyVirtuaFighter's and TinyAloneInTheDark's Skeleton
    kit_shmup ; TinyStarFox's Path and Shots, the 2D shoot 'em up kit's
    kit_sectors ; TinyDoom3d's level
    kit_heightmap ; TinyComanche3d's island
    kit_segments ; TinyDescent3d's mine
    elm_core ; Basics.clamp
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

; claude: its own stanza: TinyMinecraft uses none of the kits, and
; reads minecraft.png beside it. TinyMinecraft.ml on the GPU, its world
; kept in GPU buffers from frame to frame (see Playground3d.cached3d
; and plan_opengl_perf.md).
(executables
  (names
    TinyMinecraft
  )
  (modules TinyMinecraft Texture_atlas)
  (libraries
    elm_core
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

; claude: minecraft.png, embedded in the program as base64 (see
; Playground3d.embedded_texture and graphics/images/Base64.mli), so
; TinyMinecraft runs from any directory and its texture comes along to
; the browser -- the same trick graphics/font/dune uses for the Hershey
; font, through a script since a .png is not text.
(rule
 (targets Texture_atlas.ml)
 (deps minecraft.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml minecraft.png))))

; claude: the tomb's texture atlas, embedded the same way as
; TinyMinecraft's: tomb.png becomes Tomb_atlas.base64 at build time, so
; TinyTombRaider carries its walls with it and runs from anywhere (see
; scripts/build/make_tomb_atlas.py, which drew it).
(rule
 (targets Tomb_atlas.ml)
 (deps tomb.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml tomb.png))))

; Reuses ../StarCollector3d.ml as-is via copy_files (a build-time rule, not
; a committed duplicate/symlink -- see docs/claude_notes/done/plan_opengl.md
; and examples3d/opengl/dune's identical pattern) so the exact same
; backend-agnostic source runs against elm_playground_3d_opengl here and
; elm_playground_3d_software in ../dune, with only one real file per game.
(copy_files ../StarCollector3d.ml)
(copy_files ../TinyBattlezone.{ml,mli})
(copy_files ../TinyWolf3d.{ml,mli})
(copy_files ../TinyVirtuaRacing.{ml,mli})
(copy_files ../TinyTron3d.{ml,mli})
(copy_files ../TinyMario64.{ml,mli})
(copy_files ../TinyMarble.{ml,mli})
(copy_files ../TinyDoom3d.{ml,mli})
(copy_files ../TinyComanche3d.ml)
(copy_files ../TinyDescent3d.ml)
(copy_files ../TinyQuake.ml)
(copy_files ../TinyMinecraft.ml)

(executables
  (names
    StarCollector3d
    TinyBattlezone
    TinyWolf3d
    TinyVirtuaRacing
    TinyTron3d
    TinyMario64
    TinyMarble
    TinyDoom3d
    TinyComanche3d
    TinyDescent3d
    TinyQuake
  )
  (modules StarCollector3d TinyBattlezone TinyWolf3d TinyVirtuaRacing TinyTron3d TinyMario64 TinyMarble TinyDoom3d TinyComanche3d TinyDescent3d TinyQuake)
  (libraries
    kit_lightcycles ; TinyTron3d's rules
    kit_racing ; TinyVirtuaRacing's Road and Car
    kit_sectors ; TinyDoom3d's level
    kit_heightmap ; TinyComanche3d's island
    kit_segments ; TinyDescent3d's mine
    elm_core ; Basics.clamp
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

; TinyMinecraft.ml on the GPU, its world kept in GPU buffers from frame
; to frame (see Playground3d.cached3d and plan_opengl_perf.md). Its
; texture travels inside the program (the rule at the end of this
; file), so it runs from any directory.
(executables
  (names
    TinyMinecraft
  )
  (modules TinyMinecraft Texture_atlas)
  (libraries

    elm_core
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
  )
)

; claude: the same embedding rule as ../dune's: the texture as base64,
; beside the copied TinyMinecraft.ml
(rule
 (targets Texture_atlas.ml)
 (deps ../texture.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml ../texture.png))))

; Reuses ../StarCollector3d.ml as-is via copy_files (a build-time rule, not
; a committed duplicate/symlink -- see examples3d/software/dune's identical
; pattern) so the exact same backend-agnostic source runs against
; elm_playground_3d_software here and elm_playground_3d_opengl in ../dune,
; with only one real file per game.
(copy_files ../StarCollector3d.ml)
(copy_files ../TinyBattlezone3d.{ml,mli})
(copy_files ../TinyElite3d.ml)
(copy_files ../TinyTeardown.ml)
(copy_files ../TinyPinball3d.ml)
(copy_files ../TinyHalfLife2.ml)
(copy_files ../TinyPortal.ml)
(copy_files ../TinyWolfenstein3d.{ml,mli})
(copy_files ../TinyVirtuaRacing.{ml,mli})
(copy_files ../TinyMarioKart64.ml)
(copy_files ../TinyVirtuaFighter.ml)
(copy_files ../TinyStarFox.ml)
(copy_files ../TinyAloneInTheDark.ml)
(copy_files ../TinyTron3d.{ml,mli})
(copy_files ../TinyMario64.{ml,mli})
(copy_files ../TinyMarbleMadness.{ml,mli})
(copy_files ../TinyDoom3d.{ml,mli})
(copy_files ../TinyComanche3d.ml)
(copy_files ../TinyDescent3d.ml)
(copy_files ../TinyQuake.ml)
(copy_files ../TinyMinecraft.ml)
(copy_files ../TinyBlockout.ml)
(copy_files ../TinyTombRaider.ml)
(copy_files ../TinyBoomerangFu3d.ml)
(copy_files ../TinyHades.ml)
(copy_files ../TinyMonumentValley.ml)
(copy_files ../TinyRockBand.ml)

(executables
  (names
    StarCollector3d
    TinyBattlezone3d
    TinyElite3d
    TinyTeardown
    TinyPinball3d
    TinyHalfLife2
    TinyPortal
    TinyWolfenstein3d
    TinyVirtuaRacing
    TinyMarioKart64
    TinyVirtuaFighter
    TinyStarFox
    TinyAloneInTheDark
    TinyTron3d
    TinyMario64
    TinyMarbleMadness
    TinyDoom3d
    TinyComanche3d
    TinyDescent3d
    TinyQuake
    TinyBlockout
    TinyTombRaider
    TinyBoomerangFu3d
    TinyHades
    TinyMonumentValley
    TinyRockBand
  )
  (modules StarCollector3d TinyBattlezone3d TinyElite3d TinyTeardown TinyPinball3d TinyHalfLife2 TinyPortal TinyWolfenstein3d TinyVirtuaRacing TinyMarioKart64 TinyVirtuaFighter TinyStarFox TinyAloneInTheDark TinyTron3d TinyMario64 TinyMarbleMadness TinyDoom3d TinyComanche3d TinyDescent3d TinyQuake TinyBlockout TinyTombRaider TinyBoomerangFu3d TinyHades TinyMonumentValley TinyRockBand Tomb_atlas)
  (libraries
    kit_lightcycles ; TinyTron3d's rules
    kit_puzzle ; TinyTombRaider's Push
    kit_rhythm ; TinyRockBand's clock, grades and charts, shared with games/TinyDDR
    kit_racing ; TinyVirtuaRacing's Road and Car, TinyMarioKart64's Topdown
    kit_racing3d ; TinyMarioKart64's circuit (Track3d)
    kit_brawler ; TinyVirtuaFighter's Frame_data and Hitbox
    kit_brawler3d ; TinyVirtuaFighter's and TinyAloneInTheDark's Skeleton
    kit_shmup ; TinyStarFox's Path and Shots
    kit_sectors ; TinyDoom3d's level
    kit_heightmap ; TinyComanche3d's island
    kit_segments ; TinyDescent3d's mine
    elm_core ; Basics.clamp
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_software ; implem of virtual elm_playground_3d
  )
)

; TinyMinecraft.ml on the software rasterizer, its world kept as plain
; OCaml data redrawn each frame (unlike ../dune's OpenGL backend, which
; keeps it in GPU buffers -- see Playground3d.cached3d and
; plan_opengl_perf.md). Its texture travels inside the program (the
; rule at the end of this file), so it runs from any directory.
(executables
  (names
    TinyMinecraft
  )
  (modules TinyMinecraft Texture_atlas)
  (libraries
    elm_core
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_software ; implem of virtual elm_playground_3d
  )
)

; claude: the same embedding rule as ../dune's: the texture as base64,
; beside the copied TinyMinecraft.ml
(rule
 (targets Texture_atlas.ml)
 (deps ../minecraft.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml ../minecraft.png))))

; claude: the same embedding rule as ../dune's, for the tomb's atlas
(rule
 (targets Tomb_atlas.ml)
 (deps ../tomb.png %{project_root}/scripts/build/file_to_base64_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/build/file_to_base64_ml.ml ../tomb.png))))

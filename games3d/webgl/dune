; claude: ../StarCollector3d.ml as-is, via copy_files (see
; ../opengl/dune), linked against elm_playground_3d_webgl. Its score
; HUD shows up here (drawn by elm_playground_web's <svg>, over the
; WebGL canvas), unlike on the OpenGL backend. Minecraft3d waits for
; plan_opengl_perf.md's GPU cache (see plan_webgl.md).
(copy_files ../StarCollector3d.ml)

(executables
  (names
    StarCollector3d
  )
  (libraries
    elm_core ; Basics.clamp
    elm_playground
    elm_playground_web ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_webgl ; implem of virtual elm_playground_3d
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/games3d/webgl/
; next to the generated .bc.js (same trick as examples3d/js/dune)
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

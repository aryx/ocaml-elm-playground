(test
 (name Test)
 (libraries
   alcotest
   testo
   testutil ; Testutil_heavy, the searches make test-lite skips
   elm_core
   elm_playground
   elm_playground_software ; an implem of virtual elm_playground
   elm_playground_3d
   elm_playground_3d_software ; an implem of virtual elm_playground_3d
   graphics_3d ; Cull, against TinyElite's hidden lines
   kit_racing
   kit_racing3d ; TinyMarioKart64's circuit
   kit_brawler3d ; TinyVirtuaFighter's Skeleton
   kit_sectors
   kit_heightmap
   kit_segments
   kit_isometric
   kit_maze
   kit_lightcycles
   kit_shmup
   kit_platformer
   kit_brawler
   kit_puzzle
   kit_rhythm
   kit_sports
   ai ; AiOthello's Minimax, TinyDungeonMaster's Pathfind
   kit_rts
 )
 ; claude: 4 workers, not Testo's default of one per core: each worker
 ; starts by paying for every game's setup again, so on 64 cores this
 ; suite took 197 s of CPU for the 15 it takes here, in the same 5 s
 (action (run %{test} -j 4))
)

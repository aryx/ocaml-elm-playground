# claude: the tests that time something (Unit_matrix's two products, a
# frame against the clock in Unit_http_request) skip themselves when CI
# is set, which opam's builders do not set: one failed there, on a shared
# machine building with 32 jobs (ppc64, OCaml 5.5, 0.3.1). A timing is
# for whoever changes the code, not for whoever installs it
build-env: [ CI = "true" ]

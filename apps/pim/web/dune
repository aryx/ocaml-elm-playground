; claude: the apps in a browser: ../*.ml reused as-is by a build-time
; copy, not a committed duplicate (see examples/web/dune), and linked
; against elm_playground_web.
(copy_files ../*.ml)

(executables
  (names TinyClock TinyCalendar TinyPalmPilot)
  (modules TinyClock TinyCalendar TinyPalmPilot Palm Pim_date_book Pim_address Pim_todo Pim_memo)
  (libraries
    caps ; the File menu's authority to save, Export's and Import's
    gui ; Widget, Layout, Theme
    appkit_file_menu ; File_menu
    appkit_pim ; Ics, Vcard
    appkit_document ; Saved (TinyPalmPilot)
    graphics_font ; Hershey's strokes, the Palm's font
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: the .html pages next to the generated .bc.js, as in
; examples/web/dune
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

  (names TinyMinimoog TinyHammond TinyTB303 TinyDX7 TinyRhodes TinyCS80 TinyJuno TinySoundtracker)
  (modules TinyMinimoog TinyHammond TinyTB303 TinyDX7 TinyRhodes TinyCS80 TinyJuno TinySoundtracker)
  (libraries
    caps ; TinySoundtracker's authority to export its song
    elm_core
    elm_playground
    music_voices
    elm_playground_native ; implem of virtual elm_playground
  )
)

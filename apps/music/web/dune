; claude: the applications in a browser: ../*.ml reused as-is by a
; build-time copy, not a committed duplicate (see examples/web/dune), and
; linked against elm_playground_web.
(copy_files ../TinyMinimoog.ml)
(copy_files ../TinyHammond.ml)
(copy_files ../TinyTB303.ml)
(copy_files ../TinyDX7.ml)
(copy_files ../TinyRhodes.ml)
(copy_files ../TinyCS80.ml)
(copy_files ../TinyJuno.ml)
(copy_files ../TinyTR808.ml)
(copy_files ../TinyReBirth.ml)
(copy_files ../TinyOp1.ml)
(copy_files ../TinyOpxy.ml)
(copy_files ../TinySoundtracker.ml)

(executables
  (names TinyMinimoog TinyHammond TinyTB303 TinyDX7 TinyRhodes TinyCS80 TinyJuno TinyTR808 TinyReBirth TinyOp1 TinyOpxy TinySoundtracker)
  (modules TinyMinimoog TinyHammond TinyTB303 TinyDX7 TinyRhodes TinyCS80 TinyJuno TinyTR808 TinyReBirth TinyOp1 TinyOpxy TinySoundtracker)
  (libraries
    caps
    elm_core
    elm_playground
    music_voices
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: the .html pages next to the generated .bc.js, as in
; examples/web/dune
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

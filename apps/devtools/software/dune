(copy_files ../*.ml)

(executables
  (names TinyBasic TinyVi TinyEmacs TinyTurboPascal TinySmalltalk80 TinySqueak TinyScratch TinySnap TinyDrScheme)
  (modules TinyBasic TinyVi TinyEmacs TinyTurboPascal TinySmalltalk80 TinySqueak TinyScratch TinySnap TinyDrScheme Scratch_look Scratch_ide)
  (libraries
    basic ; Basic_parse, Basic_run, Basic_session
    scheme ; TinyDrScheme's language: the machine, the stepper, Scheme_*
    sexpr ; and its reader, Sexpr_read
    gui ; TinyDrScheme's texts, Text_edit
    appkit_editor ; Tui_vi, Tui_emacs, Tui_turbo
    smalltalk ; the Blue Book's Smalltalk-80, St_*
    caps ; TinySmalltalk80's image and file outs, in the store
    graphics_rgba ; the Smalltalk Display's pixels, a picture
    scratch ; Scratch_blocks, Scratch_text, Scratch_run (TinyScratch, TinySnap)
    appkit_blocks ; Block_layout, Block_edit
    graphics_font ; Hershey, the blocks' words measured
    elm_playground
    elm_playground_software ; implem of virtual elm_playground
  )
)

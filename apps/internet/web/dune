; claude: the apps in a browser: ../*.ml reused as-is by a build-time
; copy, not a committed duplicate (see examples/web/dune), and linked
; against elm_playground_web.
(copy_files ../*.ml)

(executables
  (names TinyIRC)
  (modules TinyIRC)
  (libraries
    caps
    networking
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

(executables
  (names TinyMosaic TinyNetscape TinyFirefox)
  (modules TinyMosaic TinyNetscape TinyFirefox)
  (libraries
    caps
    web
    appkit_browser
    internet_site
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

(executables
  (names TinyChrome)
  (modules TinyChrome)
  (libraries
    caps
    web
    appkit_browser
    internet_site
    internet_media
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

(executables
  (names TinyEudora)
  (modules TinyEudora)
  (libraries
    caps
    networking_mail
    internet_mail
    appkit_richtext
    appkit_stroke_text
    graphics_rgba graphics_png graphics_gif graphics_jpeg
    gui
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: the .html pages next to the generated .bc.js, as in
; examples/web/dune
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

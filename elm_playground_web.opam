# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.3.6"
synopsis: "Web playground platform: js_of_ocaml, vdom and SVG"
description: """
The browser platform, for a 2D program and a 3D one alike: the same
  application code as on the desktop, compiled by js_of_ocaml, its
  shapes drawn as SVG through vdom.
"""
maintainer: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
authors: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
license: "LGPL-2.1-only"
homepage: "https://github.com/aryx/ocaml-elm-playground"
bug-reports: "https://github.com/aryx/ocaml-elm-playground/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "4.14.0"}
  "vdom"
  "js_of_ocaml" {>= "6.0"}
  "elm_playground" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aryx/ocaml-elm-playground.git"
# Not on Windows: this package implements the dune virtual library
# elm_playground, and dune's check of an implementation fails there
# (ocamlobjinfo exits with 0xc0000135, opam's Windows CI)
available: [ os-family != "windows" ]

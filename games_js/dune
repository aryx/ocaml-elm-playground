(executables
  (names 
    Snake
    Pong
    Tetris
    Asteroid    
  )
  (libraries
    unix
    elm_playground
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/<dir>/ next to the
; generated .bc.js so the directory can be opened directly in a browser.
; Defining the 'default' alias overrides dune's implicit one, hence the
; explicit (alias all) to still build the executables.
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

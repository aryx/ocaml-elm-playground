# Not on Windows: elm_playground_native and elm_playground_3d_opengl,
# which it depends on, are not available there
available: [ os-family != "windows" ]
# tinybox's tests start a program that links tsdl, whose bindings
# are looked up when it starts: tsdl 1.3.0 binds SDL_RenderGetWindow, of
# SDL 2.0.22, and Ubuntu 22.04 has SDL 2.0.20 ("undefined symbol:
# SDL_RenderGetWindow", opam's CI, 0.3.1). Nothing of ours to fix: the
# failure is said to be known, there
x-ci-accept-failures: [ "ubuntu-22.04" ]

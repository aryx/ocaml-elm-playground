    TinyDoom
    TinyComanche
    TinyDescent
    TinyDungeonMaster
    TinyZaxxon
    TinyDiablo
    TinyGuitarHero
    TinyElite
    TinyBattlezone
    TinyShufflePuck
  )
  (libraries
    ai ; TinyDungeonMaster's Pathfind (the monsters' A*)
    elm_playground
    kit_racing ; TinyOutRun's Road and Car, TinyMarioKart's Topdown
    kit_sectors ; TinyDoom's level
    kit_heightmap ; TinyComanche's island
    kit_segments ; TinyDescent's mine
    kit_rhythm ; TinyGuitarHero's clock, grades, charts and difficulty
    kit_isometric ; TinyZaxxon's and TinyDiablo's projection
    elm_playground_native ; implem of virtual elm_playground
  )
)

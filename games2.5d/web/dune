; Same games as ../dune, in the browser (see games/web/dune)
(copy_files ../*.ml)

(executables
  (names
    TinyWolfenstein
    TinyOutRun
    TinyMarioKart
    TinyDoom
    TinyComanche
    TinyDescent
    TinyDungeonMaster
    TinyZaxxon
    TinyDiablo
    TinyElite
    TinyBattlezone
    TinyShufflePuck
  )
  (libraries
    ai ; TinyDungeonMaster's Pathfind (the monsters' A*)
    elm_playground
    kit_racing ; TinyOutRun's Road and Car, TinyMarioKart's Topdown
    kit_sectors ; TinyDoom's level
    kit_heightmap ; TinyComanche's island
    kit_segments ; TinyDescent's mine
    kit_isometric ; TinyZaxxon's and TinyDiablo's projection
    elm_playground_web ; implem of virtual elm_playground
  )
  (modes js)
  (link_flags -no-check-prims)
)

; the .html pages next to the .bc.js, as in games/web/dune
(rule
  (alias default)
  (deps (glob_files *.html) (alias all))
  (action (progn)))

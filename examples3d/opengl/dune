; Reuses ../Cubes3d.ml and ../Spheres3d.ml as-is via copy_files (a build-time
; rule, not a committed duplicate/symlink -- see plan_opengl.md) so the
; exact same backend-agnostic source runs against elm_playground_3d_opengl
; here and elm_playground_3d_software in ../dune, with only one real file
; per example.
(copy_files ../Triangle3d.ml)
(copy_files ../Cubes3d.ml)
(copy_files ../Spheres3d.ml)
(copy_files ../TexturedCube3d.ml)
(copy_files ../CachedGrid3d.{ml,mli})
(copy_files ../PhysicsSolarSystem3d.{ml,mli})
(copy_files ../PhysicsSpin3d.ml)
(copy_files ../PhysicsFloat3d.ml)
(copy_files ../PhysicsHitbox3d.ml)
(copy_files ../PhysicsBounce3d.ml)
(copy_files ../PhysicsMarbles3d.ml)
(copy_files ../LogoFractals3d.{ml,mli})

(executables
  (names
    Triangle3d
    Cubes3d
    Spheres3d
    TexturedCube3d
    CachedGrid3d
    PhysicsSolarSystem3d
    PhysicsSpin3d
    PhysicsFloat3d
    PhysicsHitbox3d
    PhysicsBounce3d
    PhysicsMarbles3d
    LogoFractals3d
  )
  (libraries
    elm_core
    elm_playground_software ; implem of virtual elm_playground (elm_playground_3d's own dep; the OpenGL backend's HUD uses it)
    elm_playground_3d
    elm_playground_3d_opengl ; implem of virtual elm_playground_3d
    physics_2d ; PhysicsSolarSystem3d's Kepler and Planets
    physics_3d ; PhysicsSpin3d's Quat, Body3d, Integrate3d; PhysicsFloat3d's Force3d; PhysicsHitbox3d's Hitbox3d; PhysicsBounce3d's Resolve3d; PhysicsMarbles3d's Broadphase3d
  )
)

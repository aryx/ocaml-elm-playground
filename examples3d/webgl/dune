; claude: examples linked against elm_playground_3d_webgl.
; The backend-agnostic ../*.ml as-is, via copy_files (a build-time
; copy, not a committed duplicate, see ../js/dune).
(copy_files ../Triangle3d.ml)
(copy_files ../Cube3d.ml)
(copy_files ../Cubes3d.ml)
(copy_files ../Spheres3d.ml)
(copy_files ../TexturedCube3d.ml)
(copy_files ../InteractiveCube3d.ml)
(copy_files ../PaintersAlgorithmFail3d.ml)
(copy_files ../FloatingCity3d.ml)
(copy_files ../Corridor3d.ml)
(copy_files ../CachedGrid3d.{ml,mli})
(copy_files ../PhysicsSolarSystem3d.{ml,mli})
(copy_files ../PhysicsSpin3d.ml)
(copy_files ../PhysicsFloat3d.ml)
(copy_files ../PhysicsHitbox3d.ml)
(copy_files ../PhysicsBounce3d.ml)
(copy_files ../LogoFractals3d.{ml,mli})

(executables
  (names
    Triangle3d
    Cube3d
    Cubes3d
    Spheres3d
    TexturedCube3d
    InteractiveCube3d
    PaintersAlgorithmFail3d
    FloatingCity3d
    Corridor3d
    CachedGrid3d
    PhysicsSolarSystem3d
    PhysicsSpin3d
    PhysicsFloat3d
    PhysicsHitbox3d
    PhysicsBounce3d
    LogoFractals3d
  )
  (libraries
    elm_core ; Set_.mem, Basics.clamp
    elm_playground
    elm_playground_web ; implem of virtual elm_playground (elm_playground_3d's own dep)
    elm_playground_3d
    elm_playground_3d_webgl ; implem of virtual elm_playground_3d
    physics_2d ; PhysicsSolarSystem3d's Kepler and Planets
    physics_3d ; PhysicsSpin3d's Quat, Body3d, Integrate3d; PhysicsFloat3d's Force3d; PhysicsHitbox3d's Hitbox3d; PhysicsBounce3d's Resolve3d
  )
  (modes js)
  (link_flags -no-check-prims)
)

; claude: copy the .html pages into _build/default/examples3d/webgl/
; next to the generated .bc.js (same trick as ../js/dune), and the
; textures where the pages look for them (see examples3d/dune)
(rule
  (alias default)
  (deps (glob_files *.html) (alias all) examples3d/checker.png)
  (action (progn)))

(copy_files ../PhysicsSpin3d.ml)
(copy_files ../PhysicsFloat3d.ml)
(copy_files ../PhysicsHitbox3d.ml)
(copy_files ../PhysicsBounce3d.ml)
(copy_files ../PhysicsMarbles3d.ml)
(copy_files ../PhysicsRoll3d.ml)
(copy_files ../PhysicsStack3d.ml)
(copy_files ../PhysicsWalk3d.ml)
(copy_files ../PhysicsRagdoll3d.ml)
(copy_files ../LogoFractals3d.{ml,mli})


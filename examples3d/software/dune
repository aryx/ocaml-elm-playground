; Reuses ../Triangle3d.ml etc. as-is via copy_files (a build-time rule,
; not a committed duplicate/symlink -- see ../opengl/dune's identical
; pattern before this swap, docs/claude_notes/plans/done/plan_opengl.md)
; so the exact same backend-agnostic source runs against
; elm_playground_3d_software here and elm_playground_3d_opengl in
; ../dune, with only one real file per example. Four extra ones stay
; software-only (see ../dune's trailing comment).
(copy_files ../Triangle3d.ml)
(copy_files ../Cube3d.ml)
(copy_files ../Cubes3d.ml)
(copy_files ../Spheres3d.ml)
(copy_files ../TexturedCube3d.ml)
(copy_files ../InteractiveCube3d.ml)

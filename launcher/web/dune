; claude: tinybox's menu in a browser, Tinybox_web (plan_tinybox_web.md):
; the menu and its data, no program, no sources; a program chosen is
; its own page. make website builds it with --profile=release-js and
; puts it in the assets beside the programs, its page docs/tinybox.html.
(executable
 (name Tinybox_web)
 (modules Tinybox_web)
 (libraries
   caps elm_core elm_playground catalogue
   tinybox_menu
   ojs ; the page's location
   web_fetch ; the sources' request
   tinybox_codedeps ; Code_bundle, the sources' format
   tinybox_codemap ; Codemap.use_rank, Code_rank: the uses counted before
   elm_playground_web ; implem of virtual elm_playground
 )
 (modes js)
 (link_flags -no-check-prims))

; claude: a file of the site fetched as bytes, for the pages reading a
; big one: tinybox's sources, a directory's code map's bundle
(library
 (name web_fetch)
 (wrapped false)
 (modules Fetch_bytes)
 (modes byte) ; js_of_ocaml only: ojs has no native code
 (libraries ojs js_of_ocaml))

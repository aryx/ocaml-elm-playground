; claude: the 3D previews are drawn by the software rasterizer, into an
; image shown in the menu's panel (Tinybox_menu, "Previews"): a copy of
; software/'s Shape3d_render_software, as the OpenGL backend compiles its
; own copy of the 2D one for its HUD (Hud_render, see
; playground/platforms/native/dune). Not a dependency: that module lives in
; elm_playground_3d_software, which implements elm_playground_3d, and
; tinybox links the OpenGL implementation. The module uses nothing else
; of its library, only graphics/'s, so the copy compiles alone. Edit the
; original, never Preview3d_render.ml (it is in _build only).
(rule
 (action (copy ../../playground/platforms/software/Shape3d_render_software.ml Preview3d_render.ml)))
(rule
 (action (copy ../../playground/platforms/software/Shape3d_render_software.mli Preview3d_render.mli)))

(executable
 (name Tinybox)
 (public_name tinybox)
 (package tinybox)
 (modules Tinybox Tinybox_native Tinybox_thumbs Tinybox_sources Preview3d_render
   Tinybox_thumbs_0 Tinybox_thumbs_1 Tinybox_thumbs_2 Tinybox_thumbs_3 Tinybox_thumbs_4 Tinybox_thumbs_5 Tinybox_thumbs_6 Tinybox_thumbs_7)
 (libraries
   tinybox_programs
   caps
   unix ; the menu's child process
   tinybox_menu ; the menu, this host's (Tinybox_native)
   catalogue graphics_png graphics_rgba ; the menu's data
   golden_scenes elm_playground_native_common ; the previews: the scenes' scripts, Input_script
   graphics_core graphics_3d graphics_3d_geometry graphics_raytrace graphics_images ; the 3D previews' renderer (Preview3d_render)
   terminal_unix ; Tty_unix, for -tty
   appkit_editor ; Tui_vi, Tui_emacs, Tui_turbo
   elm_playground_native ; implem of virtual elm_playground: Cairo
   elm_playground_3d_opengl ; implem of virtual elm_playground_3d
 ))

; claude: `tinybox list` in make test: every program initialized, as
; tinybox starts, so that a program doing at its top level what belongs
; in its main (reading the command line, Program.argv's failure; two
; programs of one name, Program.main's) fails the tests, not the user
(rule
 (alias runtest)
 (action
  (with-stdout-to tinybox_list.out (run %{exe:Tinybox.exe} list))))

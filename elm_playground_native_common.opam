# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.2.1"
synopsis:
  "SDL event loop + image loading shared by native 2D playground backends"
description: """
Not meant to be used directly -- the Cairo-free SDL window/event loop
  (Native_loop_2d) shared by the native 2D playground backends, and,
  as a private library, the image download/decode/GIF-animation code of
  graphics/images/ (Image_decode). A plain library rather than an
  (implements elm_playground): two implementations of the same virtual
  library can't depend on each other.
"""
maintainer: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
authors: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
license: "LGPL-2.1-only"
homepage: "https://github.com/aryx/ocaml-elm-playground"
bug-reports: "https://github.com/aryx/ocaml-elm-playground/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.08.0"}
  "logs"
  "tsdl"
  "stb_image" {>= "0.4"}
  "ocurl"
  "elm_system" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aryx/ocaml-elm-playground.git"

# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.2.1"
synopsis: "Web 3D playground platform on the GPU (WebGL 1)"
description: """
The browser platform for a 3D program: the scenes drawn by the GPU,
  reusing elm_playground_web (its 2D platform) for the event loop and,
  as SVG, the HUD.
"""
maintainer: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
authors: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
license: "LGPL-2.1-only"
homepage: "https://github.com/aryx/ocaml-elm-playground"
bug-reports: "https://github.com/aryx/ocaml-elm-playground/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.11.0"}
  "js_of_ocaml" {>= "6.0"}
  "js_of_ocaml-ppx" {>= "6.0"}
  "elm_playground_3d" {= version}
  "elm_playground_web" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aryx/ocaml-elm-playground.git"

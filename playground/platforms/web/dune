; claude: its own stanzas, not part of playground/dune's include_subdirs
(include_subdirs no)

(library
 (public_name elm_playground_web)
 (implements elm_playground)
 ; claude: Playground_platform is run_app, the loop; the Web_* are its
 ; parts, one per concern (the virtual DOM, shapes to SVG, events, sound,
 ; requests, phones, the store, the sockets)
 (modules Playground_platform Web_vdom Web_render Web_events Web_audio
   Web_http Web_phone Web_connect Web_store)
 (libraries
   vdom
   ; commons

   elm_playground
   graphics_png ; claude: Playground.bitmap's pixels, as a PNG data: URL
   js_of_ocaml ; claude: Typed_array, a bitmap's bytes put on a canvas
 )
 ;(preprocess (pps profiling.ppx))
)

; claude: and the 3D one, WebGL (the other 3D web backend, drawing
; through SVG, is in ../svg/: both implement Playground3d_platform, so
; they can't share a directory)
(library
 (public_name elm_playground_3d_webgl)
 (implements elm_playground_3d)
 ; claude: Playground3d_platform is run_app3d and the drawing; the
 ; Webgl_* are what it stands on (the two shaders, the canvas, the
 ; textures the browser loads)
 (modules Playground3d_platform Webgl_shaders Webgl_canvas Webgl_textures)
 (libraries
   js_of_ocaml ; WebGL, Dom_html, Typed_array
   elm_playground
   elm_playground_3d
   elm_playground_web ; its run_app, like elm_playground_3d_web
   graphics_3d_geometry ; Mat4, Lighting
   graphics_gpu ; Mesh_cache
 )
 (preprocess (pps js_of_ocaml-ppx))
)

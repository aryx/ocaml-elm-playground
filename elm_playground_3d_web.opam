# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.3.5"
synopsis: "Web 3D playground platform drawing through SVG"
description: """
The scene compiled every frame down to plain 2D shapes (backface
  culling, the painter's algorithm), drawn by elm_playground_web: no
  GPU needed, but for small scenes. elm_playground_3d_webgl is the web
  platform to pick otherwise.
"""
maintainer: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
authors: ["Yoann Padioleau <yoann.padioleau@gmail.com"]
license: "LGPL-2.1-only"
homepage: "https://github.com/aryx/ocaml-elm-playground"
bug-reports: "https://github.com/aryx/ocaml-elm-playground/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.0" & >= "3.17"}
  "elm_playground_3d" {= version}
  "elm_playground_web" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aryx/ocaml-elm-playground.git"
# claude: not on Windows (as elm_playground_native): dune's check of a
# virtual library's implementation fails there (ocamlobjinfo exits with
# 0xc0000135, opam's Windows CI, 0.3.0); tiny_libs, tiny_languages,
# tiny_appkits, elm_playground and elm_playground_3d build on it
available: [ os-family != "windows" ]

; claude: Smalltalk-80 from the Blue Book (plan_tiny_smalltalk.md,
; notes_smalltalk.md): St_lexer, St_ast, St_parse (the text read),
; St_chunk (the file format), St_memory (the object table), St_class
; (a class as the machine reads it), St_bytecode (the instruction set,
; a CompiledMethod), St_compile (the tree to bytecodes), St_interp (the
; interpreter: contexts, sends, returns, processes), St_primitives,
; St_boot (the kernel/*.st files bootstrapped into a running system),
; St_debug (what a debugger asks of a suspended process), St_image
; (the whole memory saved and loaded), St_bitblt (Form and BitBlt, the
; display), St_colorblt (the same in colour, Squeak's). TinySmalltalk80
; (apps/devtools/) is its environment, TinySqueak the one of the second
; kernel. And Highlight_st, the kernels' chunk files coloured for
; tinybox's code map.
;
; Pure OCaml, no Playground (languages/README.md). In the package
; tiny_languages, as tiny_languages.smalltalk.
(library
 (name smalltalk)
 (public_name tiny_languages.smalltalk)
 (wrapped false)
 (libraries highlight_code) ; Highlight_st's categories
)

; claude: the kernel's source, the chunk files of kernel/, embedded as
; strings (St_kernel.mli), in the order they are bootstrapped; and
; Squeak's kernel, the same files then those of kernel/squeak/; and
; MiniMorphic, Squeak's without its Morphic (Morphic.st, Morphs.st,
; Tools.st, Etoys.st),
; then kernel/morphic/MiniMorphic.st
(rule
 (targets St_kernel.ml)
 (deps kernel/Definitions.st kernel/Objects.st kernel/Classes.st kernel/Numbers.st
       kernel/Collections.st kernel/Streams.st kernel/Graphics.st kernel/System.st
       kernel/squeak/Closures.st kernel/squeak/Color.st kernel/squeak/Text.st
       kernel/squeak/Morphic.st kernel/squeak/Morphs.st kernel/squeak/Tools.st
       kernel/squeak/Etoys.st
       kernel/morphic/MiniMorphic.st)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from kernel/*.st by languages/smalltalk/dune *)\n")
    (echo "let files = [\n")
    (echo "(\"Definitions.st\", {st|")
    (cat kernel/Definitions.st)
    (echo "|st});\n")
    (echo "(\"Objects.st\", {st|")
    (cat kernel/Objects.st)
    (echo "|st});\n")
    (echo "(\"Classes.st\", {st|")
    (cat kernel/Classes.st)
    (echo "|st});\n")
    (echo "(\"Numbers.st\", {st|")
    (cat kernel/Numbers.st)
    (echo "|st});\n")
    (echo "(\"Collections.st\", {st|")
    (cat kernel/Collections.st)
    (echo "|st});\n")
    (echo "(\"Streams.st\", {st|")
    (cat kernel/Streams.st)
    (echo "|st});\n")
    (echo "(\"Graphics.st\", {st|")
    (cat kernel/Graphics.st)
    (echo "|st});\n")
    (echo "(\"System.st\", {st|")
    (cat kernel/System.st)
    (echo "|st});\n")
    (echo "]\n")
    (echo "let squeak_base = files @ [\n")
    (echo "(\"squeak/Closures.st\", {st|")
    (cat kernel/squeak/Closures.st)
    (echo "|st});\n")
    (echo "(\"squeak/Color.st\", {st|")
    (cat kernel/squeak/Color.st)
    (echo "|st});\n")
    (echo "(\"squeak/Text.st\", {st|")
    (cat kernel/squeak/Text.st)
    (echo "|st});\n")
    (echo "]\n")
    (echo "let squeak = squeak_base @ [\n")
    (echo "(\"squeak/Morphic.st\", {st|")
    (cat kernel/squeak/Morphic.st)
    (echo "|st});\n")
    (echo "(\"squeak/Morphs.st\", {st|")
    (cat kernel/squeak/Morphs.st)
    (echo "|st});\n")
    (echo "(\"squeak/Tools.st\", {st|")
    (cat kernel/squeak/Tools.st)
    (echo "|st});\n")
    (echo "(\"squeak/Etoys.st\", {st|")
    (cat kernel/squeak/Etoys.st)
    (echo "|st});\n")
    (echo "]\n")
    (echo "let mini_morphic = squeak_base @ [\n")
    (echo "(\"morphic/MiniMorphic.st\", {st|")
    (cat kernel/morphic/MiniMorphic.st)
    (echo "|st});\n")
    (echo "]\n")))))

; claude: what a network learned of TinyBreakout from its screen and
; its score: breakout.weights (Weights.mli: a text header saying how it
; was made, then the numbers), written by scripts/train/train_breakout.
; The game's assistant (the "a" key). A library of its own, as every
; folder of data/ is: a program carries it only if it names it. In the
; package tiny_libs, as tiny_libs.data_weights_breakout.
(include_subdirs no)

(library
 (name data_weights_breakout)
 (public_name tiny_libs.data_weights_breakout)
 (wrapped false)
)

; the file embedded as a string. Escaped (files_to_string_ml.ml), not
; between {| and |}: it is binary.
(rule
 (targets Weights_breakout.ml)
 (deps breakout.weights %{project_root}/scripts/build/files_to_string_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (run ocaml %{project_root}/scripts/build/files_to_string_ml.ml breakout.weights)
    (echo "let bytes = breakout_weights\n")))))
